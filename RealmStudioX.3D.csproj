<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RootNamespace>RealmStudioX._3D</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit" Version="3.1.2" />
    <PackageReference Include="HelixToolkit.SharpDX.Assimp" Version="3.1.2" />
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <PackageReference Include="log4net" Version="3.6.0" />
    <PackageReference Include="SkiaSharp" Version="4.156.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\" />
    <Folder Include="ViewModels\" />
    <Folder Include="Views\Dialogs\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RealmStudioShapeRenderingLib\RealmStudioShapeRenderingLib.csproj" />
    <ProjectReference Include="..\RealmStudioX.Core\RealmStudioX.Core.csproj" />
  </ItemGroup>

  <!-- Direct3D shader compiler configuration -->
  <PropertyGroup>
    <FxcPath>C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x86\fxc.exe</FxcPath>

    <ShaderSourceDirectory>$(MSBuildProjectDirectory)\Shaders</ShaderSourceDirectory>

    <ShaderOutputDirectory>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\Shaders\</ShaderOutputDirectory>
  </PropertyGroup>

  <!-- Compile the HLSL pixel shaders -->
  <Target Name="CompilePixelShaders" BeforeTargets="PrepareForBuild" Inputs="$(FxcPath);&#xD;&#xA;                $(ShaderSourceDirectory)BleachBypassEffect.fx;&#xD;&#xA;                $(ShaderSourceDirectory)CinematicBloomEffect.fx;&#xD;&#xA;                $(ShaderSourceDirectory)GrayscaleEffect.fx;&#xD;&#xA;                $(ShaderSourceDirectory)SepiaEffect.fx;&#xD;&#xA;                $(ShaderSourceDirectory)StarScintillationEffect.fx;&#xD;&#xA;                $(ShaderSourceDirectory)LensFlareEffect.fx;&#xD;&#xA;                $(ShaderSourceDirectory)include\Quad.fxh" Outputs="$(ShaderOutputDirectory)BleachBypassEffect.ps;&#xD;&#xA;                 $(ShaderOutputDirectory)CinematicBloomEffect.ps;&#xD;&#xA;                 $(ShaderOutputDirectory)GrayscaleEffect.ps;&#xD;&#xA;                 $(ShaderOutputDirectory)SepiaEffect.ps;&#xD;&#xA;                 $(ShaderOutputDirectory)StarScintillationEffect.ps;&#xD;&#xA;                 $(ShaderOutputDirectory)LensFlareEffect.ps">

    <!-- Ensure the output directory exists -->
    <MakeDir Directories="$(ShaderOutputDirectory)" />

    <!-- Bleach Bypass -->
    <Exec Command="&quot;$(FxcPath)&quot; /Gec /T ps_2_0 /E bypassPS /I&quot;$(ShaderSourceDirectory)&quot; /Fo&quot;$(ShaderOutputDirectory)BleachBypassEffect.ps&quot; &quot;$(ShaderSourceDirectory)\BleachBypassEffect.fx&quot;" />

    <!-- NVidia Bloom -->
    <Exec Command="&quot;$(FxcPath)&quot; /Gec /O3 /T ps_2_0 /E main /Fo&quot;$(ShaderOutputDirectory)NvidiaBloomDownsampleEffect.ps&quot; &quot;$(ShaderSourceDirectory)\NvidiaBloomDownsampleEffect.fx&quot;" />

    <Exec Command="&quot;$(FxcPath)&quot; /Gec /O3 /T ps_2_0 /E main /Fo&quot;$(ShaderOutputDirectory)NvidiaBloomHorizontalBlurEffect.ps&quot; &quot;$(ShaderSourceDirectory)\NvidiaBloomHorizontalBlurEffect.fx&quot;" />

    <Exec Command="&quot;$(FxcPath)&quot; /Gec /O3 /T ps_2_0 /E main /Fo&quot;$(ShaderOutputDirectory)NvidiaBloomVerticalBlurEffect.ps&quot; &quot;$(ShaderSourceDirectory)\NvidiaBloomVerticalBlurEffect.fx&quot;" />

    <Exec Command="&quot;$(FxcPath)&quot; /Gec /O3 /T ps_2_0 /E main /Fo&quot;$(ShaderOutputDirectory)NvidiaBloomCompositeEffect.ps&quot; &quot;$(ShaderSourceDirectory)\NvidiaBloomCompositeEffect.fx&quot;" />
    
    <!-- Grayscale -->
    <Exec Command="&quot;$(FxcPath)&quot; /Gec /T ps_2_0 /E main /Fo&quot;$(ShaderOutputDirectory)GrayscaleEffect.ps&quot; &quot;$(ShaderSourceDirectory)\GrayscaleEffect.fx&quot;" />

    <!-- Sepia -->
    <Exec Command="&quot;$(FxcPath)&quot; /Gec /T ps_2_0 /E main /Fo&quot;$(ShaderOutputDirectory)SepiaEffect.ps&quot; &quot;$(ShaderSourceDirectory)\SepiaEffect.fx&quot;" />

    <!-- Lens Flare Core -->
    <Exec Command="&quot;$(FxcPath)&quot; /Gec /O3 /T ps_2_0 /E main /I&quot;$(ShaderSourceDirectory)&quot; /Fo&quot;$(ShaderOutputDirectory)LensFlareCoreEffect.ps&quot; &quot;$(ShaderSourceDirectory)\LensFlareCoreEffect.fx&quot;" />

    <!-- Lens Flare Streak -->
    <Exec Command="&quot;$(FxcPath)&quot; /Gec /O3 /T ps_2_0 /E main /I&quot;$(ShaderSourceDirectory)&quot; /Fo&quot;$(ShaderOutputDirectory)LensFlareStreakEffect.ps&quot; &quot;$(ShaderSourceDirectory)\LensFlareStreakEffect.fx&quot;" />

    <!-- Lens Flare Ghosts -->
    <Exec Command="&quot;$(FxcPath)&quot; /Gec /O3 /T ps_2_0 /E main /I&quot;$(ShaderSourceDirectory)&quot; /Fo&quot;$(ShaderOutputDirectory)LensFlareGhostEffect.ps&quot; &quot;$(ShaderSourceDirectory)\LensFlareGhostEffect.fx&quot;" />

    <!-- Lens Flare Starburst -->
    <Exec Command="&quot;$(FxcPath)&quot; /Gec /O3 /T ps_2_0 /E main /I&quot;$(ShaderSourceDirectory)&quot; /Fo&quot;$(ShaderOutputDirectory)LensFlareStarburstEffect.ps&quot; &quot;$(ShaderSourceDirectory)\LensFlareStarburstEffect.fx&quot;" />    

    <!-- Star Scintillation -->
    <Exec Command="&quot;$(FxcPath)&quot; /Gec /T ps_2_0 /E PS_Scintillation /Fo&quot;$(ShaderOutputDirectory)StarScintillationEffect.ps&quot; &quot;$(ShaderSourceDirectory)\StarScintillationEffect.fx&quot;" />
    
  </Target>

  <!-- Include compiled shaders in build and publish output -->
  <ItemGroup>
    <None Include="$(ShaderOutputDirectory)BleachBypassEffect.ps">
      <Link>Shaders\BleachBypassEffect.ps</Link>
      <TargetPath>Shaders\BleachBypassEffect.ps</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <None Include="$(ShaderOutputDirectory)GrayscaleEffect.ps">
      <Link>Shaders\GrayscaleEffect.ps</Link>
      <TargetPath>Shaders\GrayscaleEffect.ps</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <None Include="$(ShaderOutputDirectory)SepiaEffect.ps">
      <Link>Shaders\SepiaEffect.ps</Link>
      <TargetPath>Shaders\SepiaEffect.ps</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <None Include="$(ShaderOutputDirectory)LensFlareCoreEffect.ps" Link="Shaders\LensFlareCoreEffect.ps" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <None Include="$(ShaderOutputDirectory)LensFlareStreakEffect.ps" Link="Shaders\LensFlareStreakEffect.ps" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <None Include="$(ShaderOutputDirectory)LensFlareGhostEffect.ps" Link="Shaders\LensFlareGhostEffect.ps" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <None Include="$(ShaderOutputDirectory)LensFlareStarburstEffect.ps" Link="Shaders\LensFlareStarburstEffect.ps" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <None Include="$(ShaderOutputDirectory)NvidiaBloomDownsampleEffect.ps" Link="Shaders\NvidiaBloomDownsampleEffect.ps" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <None Include="$(ShaderOutputDirectory)NvidiaBloomHorizontalBlurEffect.ps" Link="Shaders\NvidiaBloomHorizontalBlurEffect.ps" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <None Include="$(ShaderOutputDirectory)NvidiaBloomVerticalBlurEffect.ps" Link="Shaders\NvidiaBloomVerticalBlurEffect.ps" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <None Include="$(ShaderOutputDirectory)NvidiaBloomCompositeEffect.ps" Link="Shaders\NvidiaBloomCompositeEffect.ps" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <None Include="$(ShaderOutputDirectory)StarScintillationEffect.ps">
      <Link>Shaders\StarScintillationEffect.ps</Link>
      <TargetPath>Shaders\StarScintillationEffect.ps</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    
  </ItemGroup>  
  
</Project>
