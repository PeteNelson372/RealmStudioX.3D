<UserControl x:Class="RealmStudioX._3D.Views.Controls.ModelViewer3DXControl"
             x:Name="MVDXControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             Background="Black"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="640">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <hx:Viewport3DX
            x:Name="Viewport"
            Grid.Row="0"
            BackgroundColor="GhostWhite"
            ShowCoordinateSystem="False"
            ShowViewCube="False"
            IsRotationEnabled="True"
            IsPanEnabled="True"
            IsZoomEnabled="True"
            EnableDpiScale="True"
            ZoomAroundMouseDownPoint="False"
            UseDefaultGestures="False">

            <hx:Viewport3DX.InputBindings>

                <!-- Left drag = Pan -->
                <MouseBinding
                    Gesture="LeftClick"
                    Command="hx:ViewportCommands.Pan" />

                <!-- Right drag = Rotate -->
                <MouseBinding
                    Gesture="RightClick"
                    Command="hx:ViewportCommands.Rotate" />

            </hx:Viewport3DX.InputBindings>

            <!-- Camera -->

            <!-- Lighting -->

            <hx:AmbientLight3D x:Name="AmbientLight"
                Color="#404040" />

            <hx:DirectionalLight3D x:Name="KeyLight"
                Direction="1,1,1"
                Color="#909090" />

            <hx:DirectionalLight3D x:Name="FillLight"
                Direction="1,0.5,1"
                Color="#707070" />

        </hx:Viewport3DX>

    </Grid>

    
</UserControl>
