<UserControl x:Class="RealmStudioX._3D.Views.Controls.ModelViewerControl"
             x:Name="MVControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:htk="http://helix-toolkit.org/wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Background="WhiteSmoke"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="950">

    <Grid x:Name="SceneRoot">

        <ContentControl
            x:Name="PostProcessingHost"
            Padding="0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">

            <Grid x:Name="SceneGrid">

                <!-- Animated background -->
                <Rectangle
                    x:Name="BackgroundRectangle"
                    Fill="WhiteSmoke"
                    IsHitTestVisible="False" />

                <!-- 3D viewport -->
                <htk:HelixViewport3D
                    x:Name="HelixTKViewport"
                    Background="Transparent"
                    ZoomExtentsWhenLoaded="False"
                    IsMoveEnabled="True"
                    IsPanEnabled="True"
                    IsRotationEnabled="True"
                    IsTouchZoomEnabled="False"
                    IsZoomEnabled="True"
                    ShowViewCube="True"
                    ShowCoordinateSystem="True"
                    IsInertiaEnabled="False">

                    <htk:DefaultLights x:Name="DefaultLightsVisual" />

                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup x:Name="ModelGroup">
                                <DirectionalLight
                            x:Name="ModelDirectionalLight"
                            Color="White"
                            Direction="1,1,1" />
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>

                </htk:HelixViewport3D>

            </Grid>
        </ContentControl>
    </Grid>

</UserControl>